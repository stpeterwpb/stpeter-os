#!/bin/bash
# St. Peter OS: restart into Windows ONE time. The next normal power-on comes
# back to St. Peter OS, because the PC's boot order keeps Linux first.
#   boot-windows --check   exit 0 if Windows is installed, 1 if not
#   boot-windows           switch to Windows and restart
set -u
id=$(efibootmgr 2>/dev/null | sed -n 's/^Boot\([0-9A-Fa-f]\{4\}\)\*\{0,1\} *Windows Boot Manager.*/\1/p' | head -n1)
if [ "${1:-}" = "--check" ]; then [ -n "$id" ]; exit $?; fi
[ -n "$id" ] || { echo "Windows Boot Manager not found" >&2; exit 1; }
efibootmgr --bootnext "$id" >/dev/null || exit 1
# Restart in 2 seconds, so the home screen has time to show "Restarting…"
systemd-run --quiet --on-active=2 /usr/bin/systemctl reboot
