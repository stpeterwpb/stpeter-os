#!/usr/bin/env python3
"""St. Peter OS: Windows 11 in a virtual machine (QEMU/KVM, UEFI Secure Boot, TPM 2.0).

Runs as the TV account, inside the TV's screen session (the helper calls it).

  windows-vm status            JSON: {"installed", "installing", "phase", "percent", "running", "error"}
  windows-vm find-media        JSON: {"media": [{"kind": "iso"|"usb", "path", "name", "source"}]}
  windows-vm install PATH      start installing Windows from that media (in the background)
  windows-vm open              start Windows if needed, and show it full screen
  windows-vm hide              go back to the St. Peter screen (Windows keeps running)
  windows-vm stop              shut Windows down
  windows-vm signal            (used by the VM itself) read one request from stdin: /hide, /installed, /phase/N

Files live in /var/lib/stpeter-vm (owned by the TV account):
  windows.qcow2   the Windows disk          vars.fd       UEFI settings (Secure Boot keys)
  tpm/            the virtual TPM           state.json    install progress
  media.iso       the installer (only while installing)   setup.iso   St. Peter's setup files
  MSDM.bin        the PC's built-in Windows key (copied at power-on, if the PC has one)
"""
import json, os, re, shutil, signal, socket, subprocess, sys, time

VM = os.environ.get("STPETER_VM_DIR", "/var/lib/stpeter-vm")
PAYLOAD = os.environ.get("STPETER_WIN_PAYLOAD", "/opt/stpeter/windows-setup")
USB_CMD = os.environ.get("STPETER_USB_CMD", "sudo -n /opt/stpeter/bin/usb").split()
SEARCH = os.environ.get("STPETER_MEDIA_DIRS", "/media/usb").split(":")
TITLE = "St Peter Windows"
OVMF_CODE = "/usr/share/OVMF/OVMF_CODE_4M.ms.fd"
OVMF_VARS = "/usr/share/OVMF/OVMF_VARS_4M.ms.fd"
DISK_GB = 128                     # grows as needed; starts small
PHASES = ["copy", "install", "configure", "finish"]
FAKE = os.environ.get("STPETER_VM_FAKE") == "1"      # for testing on machines without KVM


def p(*a):
    return os.path.join(VM, *a)


def rm_tree(path):
    """Delete a folder even if parts of it are read-only (files copied from an ISO often are)."""
    def fix(func, p_, _):
        try:
            os.chmod(os.path.dirname(p_), 0o755); os.chmod(p_, 0o755); func(p_)
        except OSError:
            pass
    if os.path.exists(path):
        shutil.rmtree(path, onerror=fix)


# ------------------------------------------------------------------ state
def load():
    try:
        with open(p("state.json")) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def save(**kw):
    st = load(); st.update(kw)
    os.makedirs(VM, exist_ok=True)
    tmp = p("state.json.tmp")
    with open(tmp, "w") as f:
        json.dump(st, f)
    os.replace(tmp, p("state.json"))
    return st


def qemu_pid():
    try:
        pid = int(open(p("qemu.pid")).read().strip())
        os.kill(pid, 0)
        return pid
    except (OSError, ValueError):
        return None


def status():
    st = load()
    installing = st.get("phase") in PHASES
    pct = 0
    if installing:
        i = PHASES.index(st["phase"])
        pct = [3, 15, 80, 95][i]
        if st["phase"] == "copy" and st.get("copy_total"):
            pct = 3 + int(12 * min(1, st.get("copy_done", 0) / st["copy_total"]))
        if st["phase"] == "install":       # Windows setup takes ~25 min on an N100; creep towards 75%
            pct = 15 + int(60 * min(1, (time.time() - st.get("phase_at", time.time())) / 1800))
    return {"installed": bool(st.get("installed")), "installing": installing, "phase": st.get("phase"),
            "percent": pct, "running": bool(qemu_pid()), "error": st.get("error"),
            "started": st.get("started"), "kvm": os.path.exists("/dev/kvm") or FAKE}


# ------------------------------------------------------------------ installation media
def run(cmd, timeout=60, **kw):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout, **kw)
    except (OSError, subprocess.TimeoutExpired) as e:
        return subprocess.CompletedProcess(cmd, 99, "", str(e))


def iso_is_windows(path):
    out = run(["7z", "l", "-ba", path], timeout=60).stdout.lower().replace("\\", "/")
    return bool(re.search(r"sources/install\.(wim|esd|swm)", out)) and "efi/microsoft/boot/efisys" in out


def folder_is_windows(root):
    s = os.path.join(root, "sources")
    if not os.path.isdir(s):
        return False
    names = {n.lower() for n in os.listdir(s)}
    return bool(names & {"install.wim", "install.esd", "install.swm"}) and os.path.exists(os.path.join(root, "setup.exe"))


def find_media():
    try:
        drives = json.loads(run(USB_CMD + ["mount"], timeout=40).stdout or "{}").get("drives", [])
    except ValueError:
        drives = []
    media = []
    for base in SEARCH:
        if not os.path.isdir(base):
            continue
        for d in sorted(os.listdir(base)):
            root = os.path.join(base, d)
            if not os.path.isdir(root):
                continue
            if folder_is_windows(root):
                media.append({"kind": "usb", "path": root, "name": "Windows installer", "source": d})
            for dirpath, dirs, files in os.walk(root):
                if dirpath[len(root):].count(os.sep) >= 2:
                    dirs[:] = []
                dirs[:] = [x for x in dirs if not x.startswith((".", "$")) and x != "System Volume Information"]
                for fn in files:
                    full = os.path.join(dirpath, fn)
                    if fn.lower().endswith(".iso") and os.path.getsize(full) > 2_000_000_000 and iso_is_windows(full):
                        media.append({"kind": "iso", "path": full, "name": fn, "source": d})
    return {"media": media, "drives": drives}


def allowed(path):
    real = os.path.realpath(path)
    return any(real.startswith(os.path.realpath(b) + os.sep) for b in SEARCH if b)


# ------------------------------------------------------------------ install (runs detached)
def copy_with_progress(src, dst):
    total = os.path.getsize(src); done = 0
    save(copy_total=total, copy_done=0)
    with open(src, "rb") as a, open(dst + ".part", "wb") as b:
        while True:
            buf = a.read(8 << 20)
            if not buf:
                break
            b.write(buf); done += len(buf)
            if done % (256 << 20) < (8 << 20):
                save(copy_done=done)
    os.replace(dst + ".part", dst)


def iso_from_folder(src, dst):
    """A Windows installer USB stick -> a bootable installer ISO (like the official one)."""
    stage = p("stage")
    rm_tree(stage)
    total = sum(os.path.getsize(os.path.join(d, f)) for d, _, fs in os.walk(src) for f in fs)
    save(copy_total=total, copy_done=0)
    done = 0
    for d, dirs, files in os.walk(src):
        rel = os.path.relpath(d, src)
        os.makedirs(os.path.join(stage, rel), exist_ok=True)
        for f in files:
            shutil.copyfile(os.path.join(d, f), os.path.join(stage, rel, f))
            done += os.path.getsize(os.path.join(d, f)); save(copy_done=done)
    # find the El Torito UEFI boot image the way Microsoft's ISOs have it
    boot = None
    for cand in ("efi/microsoft/boot/efisys_noprompt.bin", "efi/microsoft/boot/efisys.bin"):
        for d, _, fs in os.walk(stage):
            for f in fs:
                rp = os.path.relpath(os.path.join(d, f), stage).replace(os.sep, "/")
                if rp.lower() == cand:
                    boot = rp
        if boot:
            break
    if not boot:
        raise RuntimeError("no-efisys")
    # big install.wim (> 4 GB) is split into .swm parts, which Windows Setup reads natively
    srcdir = os.path.join(stage, "sources")
    for f in os.listdir(srcdir):
        full = os.path.join(srcdir, f)
        if f.lower() == "install.wim" and os.path.getsize(full) > 3_900_000_000:
            r = run(["wimlib-imagex", "split", full, os.path.join(srcdir, "install.swm"), "3800"], timeout=3600)
            if r.returncode != 0:
                raise RuntimeError("split")
            os.remove(full)
    r = run(["xorriso", "-as", "mkisofs", "-iso-level", "3", "-J", "-joliet-long", "-r", "-V", "WIN11_INSTALL",
             "-no-emul-boot", "-e", boot, "-o", dst, stage], timeout=3600)
    rm_tree(stage)
    if r.returncode != 0:
        raise RuntimeError("iso")


def make_setup_iso():
    """St. Peter's answer file, drivers and customization scripts, on a second virtual CD."""
    st = load()
    work = p("setup")
    rm_tree(work)
    shutil.copytree(PAYLOAD, work)
    for d, dirs, files in os.walk(work):                     # make the copy writable
        for n in dirs:
            os.chmod(os.path.join(d, n), 0o755)
        for n in files:
            os.chmod(os.path.join(d, n), 0o644)
    xml_path = os.path.join(work, "autounattend.xml")
    xml = open(xml_path, encoding="utf-8").read()
    host = re.sub(r"[^A-Za-z0-9-]", "", socket.gethostname().replace("stpeter-", "STP-"))[:15] or "STPETER-TV"
    xml = xml.replace("{{COMPUTER_NAME}}", host)
    # With the PC's own key (MSDM), Windows activates by itself; otherwise use Microsoft's
    # generic setup key for Windows 11 Pro (installs, but asks to be activated later).
    key = "" if os.path.exists(p("MSDM.bin")) else "VK7JG-NPHTM-C97JM-9MPGT-3V66T"
    xml = xml.replace("{{PRODUCT_KEY_BLOCK}}",
                      f"<ProductKey><Key>{key}</Key><WillShowUI>Never</WillShowUI></ProductKey>" if key else
                      "<ProductKey><WillShowUI>Never</WillShowUI></ProductKey>")
    # With the PC's key, Windows picks the matching edition (Home or Pro) by itself; otherwise Pro.
    xml = xml.replace("{{IMAGE_SELECT}}", "" if not key else
                      '<InstallFrom><MetaData wcm:action="add"><Key>/IMAGE/NAME</Key>'
                      '<Value>Windows 11 Pro</Value></MetaData></InstallFrom>')
    open(xml_path, "w", encoding="utf-8").write(xml)
    open(os.path.join(work, "stpeter.tag"), "w").write(st.get("started_at", "") + "\n")
    r = run(["xorriso", "-as", "mkisofs", "-iso-level", "3", "-J", "-joliet-long", "-r", "-V", "STPETER",
             "-o", p("setup.iso"), work], timeout=600)
    rm_tree(work)
    if r.returncode != 0:
        raise RuntimeError("setup-iso")


def install(src):
    save(phase="copy", phase_at=time.time(), started=time.time(), error=None, installed=False)
    try:
        if os.path.isdir(src):
            iso_from_folder(src, p("media.iso"))
        else:
            copy_with_progress(src, p("media.iso"))
        make_setup_iso()
        for f in ("windows.qcow2", "vars.fd"):
            if os.path.exists(p(f)):
                os.remove(p(f))
        rm_tree(p("tpm"))
        r = run(["qemu-img", "create", "-f", "qcow2", p("windows.qcow2"), f"{DISK_GB}G"])
        if r.returncode != 0:
            raise RuntimeError("disk")
        shutil.copyfile(OVMF_VARS, p("vars.fd"))
        save(phase="install", phase_at=time.time())
        code = launch(installing=True, wait=True)
        st = load()
        if not st.get("installed"):
            raise RuntimeError("setup-stopped" if code == 0 else f"qemu-{code}")
        for f in ("media.iso", "setup.iso"):
            try:
                os.remove(p(f))
            except OSError:
                pass
        save(phase=None, error=None)
    except Exception as e:                                       # noqa: BLE001 - shown on the TV
        save(phase=None, error=str(e) or "failed")


# ------------------------------------------------------------------ running the VM
def mem_mb():
    total = int(open("/proc/meminfo").read().split()[1]) // 1024
    return max(4096, min(8192, total - 4096))


def cpus():
    return max(2, (os.cpu_count() or 4) - 1)


def start_tpm():
    os.makedirs(p("tpm"), exist_ok=True)
    sock = p("tpm", "swtpm-sock")
    if os.path.exists(sock):
        try:
            s = socket.socket(socket.AF_UNIX); s.connect(sock); s.close(); return sock
        except OSError:
            os.remove(sock)
    run(["swtpm", "socket", "--tpm2", "--tpmstate", "dir=" + p("tpm"), "--ctrl", f"type=unixio,path={sock}",
         "--daemon", "--terminate"], timeout=20)
    for _ in range(50):
        if os.path.exists(sock):
            break
        time.sleep(0.1)
    return sock


def audio_backend():
    """TV sound (PipeWire's PulseAudio socket) if it's running; otherwise Windows starts without sound."""
    rt = os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
    os.environ.setdefault("XDG_RUNTIME_DIR", rt)
    return "pa,id=snd0" if os.path.exists(os.path.join(rt, "pulse", "native")) else "none,id=snd0"


def qemu_cmd(installing):
    cmd = ["qemu-system-x86_64", "-name", TITLE, "-machine", "q35,smm=on,accel=kvm" if not FAKE else "q35,smm=on,accel=tcg",
           "-cpu", "host" if not FAKE else "max", "-smp", str(cpus()), "-m", str(mem_mb()),
           "-global", "driver=cfi.pflash01,property=secure,value=on",
           "-drive", f"if=pflash,format=raw,unit=0,readonly=on,file={OVMF_CODE}",
           "-drive", f"if=pflash,format=raw,unit=1,file={p('vars.fd')}",
           "-chardev", f"socket,id=chrtpm,path={start_tpm()}", "-tpmdev", "emulator,id=tpm0,chardev=chrtpm",
           "-device", "tpm-crb,tpmdev=tpm0",
           "-drive", f"if=none,id=disk0,file={p('windows.qcow2')},format=qcow2,discard=unmap,cache=writeback",
           "-device", "virtio-blk-pci,drive=disk0,bootindex=1",
           "-netdev", "user,id=net0,guestfwd=tcp:10.0.2.100:80-cmd:" + os.path.abspath(sys.argv[0]) + " signal",
           "-device", "virtio-net-pci,netdev=net0",
           "-device", "virtio-vga,xres=1920,yres=1080",
           "-device", "qemu-xhci", "-device", "usb-tablet", "-device", "usb-kbd",
           "-device", "virtio-balloon", "-device", "virtio-serial",
           "-audiodev", audio_backend(), "-device", "ich9-intel-hda", "-device", "hda-output,audiodev=snd0",
           "-rtc", "base=localtime,clock=host",
           "-pidfile", p("qemu.pid"), "-qmp", f"unix:{p('qmp.sock')},server=on,wait=off"]
    if os.path.exists(p("MSDM.bin")):
        cmd += ["-acpitable", "file=" + p("MSDM.bin")]
    if installing:
        cmd += ["-drive", f"if=none,id=cd0,media=cdrom,readonly=on,file={p('media.iso')}",
                "-device", "ide-cd,drive=cd0,bus=ide.0,bootindex=0",
                "-drive", f"if=none,id=cd1,media=cdrom,readonly=on,file={p('setup.iso')}",
                "-device", "ide-cd,drive=cd1,bus=ide.1",
                "-display", "none"]
    else:
        cmd += ["-display", "gtk,full-screen=on,zoom-to-fit=on,show-menubar=off,show-tabs=off,grab-on-hover=off"]
    return cmd


def launch(installing=False, wait=False):
    if qemu_pid():
        return None
    log = open(p("qemu.log"), "a")
    log.write(f"\n--- {time.ctime()} {'install' if installing else 'run'}\n"); log.flush()
    proc = subprocess.Popen(qemu_cmd(installing), stdout=log, stderr=log, stdin=subprocess.DEVNULL,
                            start_new_session=True)
    if not wait:
        return proc
    if installing:
        press_keys_for(25)
    return proc.wait()


def detach():
    """Become a background process that doesn't hold the helper's request open."""
    os.setsid()
    signal.signal(signal.SIGHUP, signal.SIG_IGN)
    fd = os.open(os.devnull, os.O_RDWR)
    for n in (0, 1, 2):
        os.dup2(fd, n)


def press_keys_for(seconds):
    """Microsoft's installer ISO waits for "Press any key to boot from CD": press Enter for it."""
    end = time.time() + seconds
    while time.time() < end:
        try:
            s = socket.socket(socket.AF_UNIX); s.settimeout(2); s.connect(p("qmp.sock"))
            s.recv(4096); s.sendall(b'{"execute":"qmp_capabilities"}\n'); s.recv(4096)
            while time.time() < end:
                s.sendall(b'{"execute":"send-key","arguments":{"keys":[{"type":"qcode","data":"ret"}]}}\n')
                s.recv(4096); time.sleep(1)
            s.close()
        except OSError:
            time.sleep(0.5)


def xdo(*a):
    return run(["xdotool", *a], timeout=10)


def vm_window():
    out = xdo("search", "--name", re.escape(TITLE)).stdout.split()
    return out[-1] if out else None


def browser_window():
    out = xdo("search", "--class", "firefox").stdout.split()
    return out[-1] if out else None


def keys(mode):
    """Inside Windows every shortcut must work (Ctrl+T, Ctrl+N… are blocked only for the browser)."""
    home = os.path.expanduser("~/.config/openbox")
    src = os.path.join(home, "rc-windows.xml" if mode == "windows" else "rc-tv.xml")
    if os.path.exists(src):
        shutil.copyfile(src, os.path.join(home, "rc.xml"))
        run(["openbox", "--reconfigure"], timeout=10)


def open_vm():
    st = load()
    if not st.get("installed"):
        return {"ok": False, "error": "not-installed"}
    if not qemu_pid():
        proc = launch()
        # once Windows shuts down, come back to the St. Peter screen by itself
        if proc and os.fork() == 0:
            detach()
            pid = proc.pid                      # watch this exact process until Windows shuts down
            while True:
                try:
                    os.kill(pid, 0)
                except OSError:
                    break
                time.sleep(2)
            keys("tv")
            b = browser_window()
            if b:
                xdo("windowactivate", b)
            os._exit(0)
    keys("windows")
    for _ in range(60):
        w = vm_window()
        if w:
            xdo("windowmap", w); xdo("windowactivate", w)
            return {"ok": True}
        time.sleep(0.25)
    return {"ok": True, "starting": True}


def hide():
    keys("tv")
    w = vm_window()
    if w:
        xdo("windowminimize", w)
    b = browser_window()
    if b:
        xdo("windowactivate", b)
    return {"ok": True}


def stop():
    try:
        s = socket.socket(socket.AF_UNIX); s.connect(p("qmp.sock"))
        s.recv(4096); s.sendall(b'{"execute":"qmp_capabilities"}\n'); s.recv(4096)
        s.sendall(b'{"execute":"system_powerdown"}\n'); s.close()
        return {"ok": True}
    except OSError:
        return {"ok": False}


def signal_cmd():
    """One HTTP request from Windows (via the VM's private address 10.0.2.100). Tiny and strict."""
    line = sys.stdin.readline().strip()
    m = re.match(r"(GET|POST) (/[a-z0-9/]*) HTTP", line)
    path = m.group(2) if m else ""
    if path == "/hide":
        hide()
    elif path == "/installed":
        save(installed=True, phase="finish", phase_at=time.time())
    elif re.fullmatch(r"/phase/(configure|finish)", path):
        save(phase=path.split("/")[-1], phase_at=time.time())
    body = b"ok\n"
    sys.stdout.buffer.write(b"HTTP/1.0 200 OK\r\nContent-Type: text/plain\r\nContent-Length: 3\r\nConnection: close\r\n\r\n" + body)
    sys.stdout.flush()


if __name__ == "__main__":
    cmd = sys.argv[1] if len(sys.argv) > 1 else ""
    if cmd == "status":
        print(json.dumps(status()))
    elif cmd == "find-media":
        print(json.dumps(find_media()))
    elif cmd == "install":
        src = sys.argv[2] if len(sys.argv) > 2 else ""
        if not src or not os.path.exists(src) or not allowed(src):
            print(json.dumps({"ok": False, "error": "not-found"})); sys.exit(0)
        if status()["installing"]:
            print(json.dumps({"ok": True, "already": True})); sys.exit(0)
        if not (os.path.exists("/dev/kvm") or FAKE):
            print(json.dumps({"ok": False, "error": "no-kvm"})); sys.exit(0)
        os.makedirs(VM, exist_ok=True)
        save(phase="copy", phase_at=time.time(), started=time.time(), error=None)
        if os.fork() == 0:                    # keep going after the helper's request ends
            detach()
            install(src)
            os._exit(0)
        print(json.dumps({"ok": True}))
    elif cmd == "open":
        print(json.dumps(open_vm()))
    elif cmd == "hide":
        print(json.dumps(hide()))
    elif cmd == "stop":
        print(json.dumps(stop()))
    elif cmd == "signal":
        signal_cmd()
    else:
        print(__doc__, file=sys.stderr); sys.exit(2)
